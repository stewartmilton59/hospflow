# HospFlow Environment Configuration
# For local SQLite testing, just change SECRET_KEY and leave everything else commented out

DEBUG=False
SECRET_KEY=my-super-secret-random-development-key-123456789
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - Uncomment for PostgreSQL production setup
# DATABASE_URL=postgres://hospflow_user:secure_password@localhost:5432/hospflow_db
# CONN_MAX_AGE=600

# For SQLite (default local testing), leave DATABASE_URL empty or commented

# Cache & Message Broker - Uncomment for Redis production setup
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1

# For local testing without Redis, leave these commented (uses local memory)

# Timezone & Localization
TIME_ZONE=Africa/Dar_es_Salaam
LANGUAGE_CODE=sw

# Security (relaxed for local dev, strict for production)
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Encryption (generate with: openssl rand -base64 32)
FIELD_ENCRYPTION_KEY=base64-encoded-32-byte-key-for-aes-256-gcm

# NIDA Integration (optional for local testing)
NIDA_API_BASE_URL=https://api.nida.go.tz/v1
NIDA_CIG_CLIENT_ID=your-cig-client-id
NIDA_CIG_CLIENT_SECRET=your-cig-secret

# TRA VFD Configuration (optional for local testing)
VFD_API_BASE_URL=https://vfd.tra.go.tz/api/v1
VFD_TAX_PAYER_ID=123-456-789
VFD_SERIAL_NUMBER=TRA-VFD-2026-001
VFD_PRIVATE_KEY_PATH=/secure/keys/vfd_private.pem
VFD_REGISTRATION_KEY=your-registration-key

# NHIF Configuration (optional for local testing)
NHIF_API_BASE_URL=https://nhifapi.go.tz/api
NHIF_CLIENT_ID=your-nhif-client-id
NHIF_CLIENT_SECRET=your-nhif-secret
NHIF_FACILITY_CODE=FAC123456

# SMS Provider (optional for local testing)
SMS_PROVIDER=notify_africa
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-secret
SMS_SENDER_ID=HOSPFLW

# DHIS2 Integration (optional for local testing)
DHIS2_BASE_URL=https://dhis2.moh.go.tz/api
DHIS2_USERNAME=hospflow_integration
DHIS2_PASSWORD=secure_password
DHIS2_ORG_UNIT_ID=UID12345678

# Sentry (optional)
SENTRY_DSN=
